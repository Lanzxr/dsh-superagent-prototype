# Company Agent controlled web access for DSSuperAgent.
# The Company Agent Web Gate must be running before DSSuperAgent handles requests.
COMPANY_AGENT_WEB_GATE_URL=http://127.0.0.1:8767/internal/web/authorize

# Keep empty when the gate is bound to loopback on the same machine.
# For a non-loopback deployment, set the same random 32+ character value in
# Company Agent's COMPANY_AGENT_WEB_GATE_API_KEY.
COMPANY_AGENT_WEB_GATE_API_KEY=

# Knowledge search is a separate capability and is configured independently.
# COMPANY_AGENT_KNOWLEDGE_API_URL=http://127.0.0.1:8766/internal/knowledge/search
# COMPANY_AGENT_KNOWLEDGE_API_KEY=
